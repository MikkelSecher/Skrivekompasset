@page "/"
@rendermode InteractiveServer
@using Ordbogen.Skrivekompasset.Models
@using Ordbogen.Skrivekompasset.Services
@inject SkrivekompassetService Skrivekompasset
@inject ILogger<Home> Log
@implements IDisposable

<PageTitle>Skrivekompasset</PageTitle>

<div class="skrivekompasset">
    <header class="skrivekompasset-header">
        <h1>Skrivekompasset</h1>
        <p class="lead">@LeadText</p>
    </header>

    <div class="mode-toggle" role="tablist">
        <button class="mode-tab @(_mode == CoachMode.Stavning ? "active" : "")"
                role="tab"
                aria-selected="@(_mode == CoachMode.Stavning)"
                disabled="@_isChecking"
                @onclick="() => SetMode(CoachMode.Stavning)">
            Stavning &amp; grammatik
        </button>
        <button class="mode-tab @(_mode == CoachMode.Forbedringer ? "active" : "")"
                role="tab"
                aria-selected="@(_mode == CoachMode.Forbedringer)"
                disabled="@_isChecking"
                @onclick="() => SetMode(CoachMode.Forbedringer)">
            Forbedringsforslag
        </button>
        <button class="mode-tab @(_mode == CoachMode.Laerer ? "active" : "")"
                role="tab"
                aria-selected="@(_mode == CoachMode.Laerer)"
                disabled="@_isChecking"
                @onclick="() => SetMode(CoachMode.Laerer)">
            Lærer-feedback
        </button>
        <button class="mode-tab @(_mode == CoachMode.Hjaelp ? "active" : "")"
                role="tab"
                aria-selected="@(_mode == CoachMode.Hjaelp)"
                disabled="@_isChecking"
                @onclick="() => SetMode(CoachMode.Hjaelp)">
            Hjælp i gang
        </button>
    </div>

    @if (_mode == CoachMode.Laerer || _mode == CoachMode.Hjaelp)
    {
        <div class="klassetrin-vaelger">
            <label for="klassetrin">Klassetrin:</label>
            <select id="klassetrin"
                    class="klassetrin-select"
                    disabled="@_isChecking"
                    @bind="_klassetrin">
                <option value="@Klassetrin.Indskoling">Indskoling (0.-3. klasse)</option>
                <option value="@Klassetrin.Mellemtrin">Mellemtrin (4.-6. klasse)</option>
                <option value="@Klassetrin.Udskoling">Udskoling (7.-9. klasse)</option>
                <option value="@Klassetrin.Gymnasium">Gymnasium</option>
                <option value="@Klassetrin.Voksen">Voksen / generelt</option>
            </select>
        </div>
    }

    <div class="skrivekompasset-layout">
        <section class="editor-pane">
            @if (!HarResultat)
            {
                <textarea class="editor-input"
                          @bind="CurrentInput"
                          @bind:event="oninput"
                          placeholder="@PlaceholderText"
                          rows="14"
                          maxlength="@Skrivekompasset.MaxInputCharacters"
                          disabled="@_isChecking"></textarea>
                <div class="char-counter @CounterCssClass">
                    @if (CurrentInput.Length > Skrivekompasset.MaxInputCharacters)
                    {
                        <span>For lang — fjern @(CurrentInput.Length - Skrivekompasset.MaxInputCharacters) tegn.</span>
                    }
                    <span class="char-counter-tal">@CurrentInput.Length.ToString("N0") / @Skrivekompasset.MaxInputCharacters.ToString("N0")</span>
                </div>
            }
            else if (_mode == CoachMode.Stavning && _corrections is not null)
            {
                <AnnotatedText Text="@_tekst" Corrections="@_corrections" />
            }
            else if (_mode == CoachMode.Forbedringer && _forbedringer is not null)
            {
                <div class="paragraph-view">
                    @for (var i = 0; i < _afsnit.Length; i++)
                    {
                        var idx = i;
                        var harForslag = _forbedringer.Any(f => f.ParagraphIndex == idx);
                        <p class="afsnit @(harForslag ? "afsnit-har-forslag" : "")">
                            @if (harForslag)
                            {
                                <span class="afsnit-marker" title="Forslag tilgængeligt">💡</span>
                            }
                            @_afsnit[idx]
                        </p>
                    }
                </div>
            }
            else if (_mode == CoachMode.Laerer && _laererFeedback is not null)
            {
                <div class="readonly-text">@_tekst</div>
            }
            else if (_mode == CoachMode.Hjaelp && _opgaveHjaelp is not null)
            {
                <div class="readonly-text">@_hjaelpTekst</div>
            }

            <div class="editor-actions">
                @if (!HarResultat)
                {
                    <button class="btn-primary" @onclick="TjekAsync" disabled="@(_isChecking || string.IsNullOrWhiteSpace(CurrentInput) || CurrentInput.Length > Skrivekompasset.MaxInputCharacters)">
                        @if (_isChecking)
                        {
                            <span class="spinner"></span>
                            <span>@CheckingLabel</span>
                            <span class="elapsed">@_elapsedSeconds.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("da-DK"))s</span>
                        }
                        else
                        {
                            <span>@CheckButtonLabel</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn-secondary" @onclick="Rediger">Rediger igen</button>
                    @if (_mode == CoachMode.Stavning && _corrections is { Count: > 0 })
                    {
                        <button class="btn-primary" @onclick="AnvendAlleCorrections">Anvend alle (@_corrections.Count)</button>
                    }
                    else if (_mode == CoachMode.Forbedringer && _forbedringer is { Count: > 0 })
                    {
                        <button class="btn-primary" @onclick="AnvendAlleForbedringer">Anvend alle (@_forbedringer.Count)</button>
                    }
                }
                <button class="btn-link" @onclick="Ryd" disabled="@_isChecking">Ryd</button>
            </div>

            @if (_isChecking)
            {
                <p class="patience-note">
                    AI-svar tager ofte 10+ sekunder — vær tålmodig mens den arbejder.
                </p>
            }

            @if (!string.IsNullOrEmpty(_fejlbesked))
            {
                <div class="error-banner">
                    <strong>Fejl:</strong> @_fejlbesked
                </div>
            }
        </section>

        <aside class="sidepanel">
            @if (!HarResultat)
            {
                <div class="sidepanel-empty">
                    <p>@SidepanelEmptyText</p>
                    <details open>
                        <summary>Eksempel</summary>
                        <button class="btn-link" @onclick="IndsætEksempel">Indsæt eksempel-tekst</button>
                    </details>
                </div>
            }
            else if (_mode == CoachMode.Stavning && _corrections is not null)
            {
                @if (_corrections.Count == 0)
                {
                    <div class="sidepanel-success">
                        <div class="check-icon" aria-hidden="true">✓</div>
                        <h3>Ingen fejl fundet</h3>
                        <p>Modellen fandt ingen stave-, grammatik- eller stilfejl i teksten.</p>
                        <button class="btn-secondary" @onclick="Rediger">Rediger tekst</button>
                    </div>
                }
                else
                {
                    <h3>@_corrections.Count fejl fundet</h3>
                    <ul class="correction-list">
                        @for (var i = 0; i < _corrections.Count; i++)
                        {
                            var idx = i;
                            var c = _corrections[idx];
                            <li class="correction @CssClassFor(c)">
                                <div class="correction-head">
                                    <span class="badge">@LabelFor(c)</span>
                                </div>
                                <div class="correction-diff">
                                    <span class="from">@c.Original</span>
                                    <span class="arrow">→</span>
                                    <span class="to">@(string.IsNullOrEmpty(c.Suggested) ? "(slet)" : c.Suggested)</span>
                                </div>
                                <p class="correction-explanation">@c.Explanation</p>
                                <div class="correction-actions">
                                    <button class="btn-small btn-primary" @onclick="() => AnvendCorrection(idx)">Anvend</button>
                                    <button class="btn-small btn-link" @onclick="() => IgnorerCorrection(idx)">Ignorer</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
            else if (_mode == CoachMode.Hjaelp && _opgaveHjaelp is not null)
            {
                <div class="opgave-hjaelp">
                    <div class="laerer-header">
                        <span class="badge">@KlassetrinLabel(_klassetrin)</span>
                    </div>
                    <section class="laerer-section forstaa">
                        <h4>📖 Sådan forstår jeg opgaven</h4>
                        <p>@_opgaveHjaelp.ForstaaOpgaven</p>
                    </section>
                    @if (_opgaveHjaelp.Trin is { Count: > 0 })
                    {
                        <section class="laerer-section trin-section">
                            <h4>🪜 Trin du kan tage</h4>
                            <ol class="trin-list">
                                @foreach (var t in _opgaveHjaelp.Trin)
                                {
                                    <li class="trin">
                                        <div class="trin-titel">@t.Titel</div>
                                        <p class="trin-beskrivelse">@t.Beskrivelse</p>
                                    </li>
                                }
                            </ol>
                        </section>
                    }
                    @if (_opgaveHjaelp.SpoergsmaalTilDigSelv is { Count: > 0 })
                    {
                        <section class="laerer-section spoergsmaal-section">
                            <h4>🤔 Spørgsmål du kan stille dig selv</h4>
                            <ul class="spoergsmaal-list">
                                @foreach (var s in _opgaveHjaelp.SpoergsmaalTilDigSelv)
                                {
                                    <li>@s</li>
                                }
                            </ul>
                        </section>
                    }
                    @if (_opgaveHjaelp.PasPaa is { Count: > 0 })
                    {
                        <section class="laerer-section pas-paa-section">
                            <h4>⚠️ Pas på</h4>
                            <ul class="pas-paa-list">
                                @foreach (var p in _opgaveHjaelp.PasPaa)
                                {
                                    <li>@p</li>
                                }
                            </ul>
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(_opgaveHjaelp.Afslutning))
                    {
                        <p class="laerer-samlet">@_opgaveHjaelp.Afslutning</p>
                    }
                    <div class="laerer-actions">
                        <button class="btn-secondary" @onclick="Rediger">Rediger opgave</button>
                    </div>
                </div>
            }
            else if (_mode == CoachMode.Laerer && _laererFeedback is not null)
            {
                <div class="laerer-feedback">
                    <div class="laerer-header">
                        <span class="badge">@KlassetrinLabel(_klassetrin)</span>
                    </div>
                    <section class="laerer-section ros">
                        <h4>👍 Det er du god til</h4>
                        <p>@_laererFeedback.Ros</p>
                    </section>
                    @if (_laererFeedback.Udfordringer is { Count: > 0 })
                    {
                        <section class="laerer-section udfordringer">
                            <h4>💡 Det her kan blive bedre</h4>
                            <ul class="udfordring-list">
                                @foreach (var u in _laererFeedback.Udfordringer)
                                {
                                    <li class="udfordring">
                                        <div class="udfordring-omraade">@u.Omraade</div>
                                        <p class="udfordring-kommentar">@u.Kommentar</p>
                                        @if (!string.IsNullOrWhiteSpace(u.EksempelFraTekst))
                                        {
                                            <blockquote class="udfordring-eksempel">@u.EksempelFraTekst</blockquote>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(u.Forslag))
                                        {
                                            <p class="udfordring-forslag"><strong>Forslag:</strong> @u.Forslag</p>
                                        }
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                    @if (_laererFeedback.NaesteSkridt is { Count: > 0 })
                    {
                        <section class="laerer-section skridt">
                            <h4>✅ Næste skridt</h4>
                            <ul class="skridt-list">
                                @foreach (var s in _laererFeedback.NaesteSkridt)
                                {
                                    <li>@s</li>
                                }
                            </ul>
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(_laererFeedback.Samlet))
                    {
                        <p class="laerer-samlet">@_laererFeedback.Samlet</p>
                    }
                    <div class="laerer-actions">
                        <button class="btn-secondary" @onclick="Rediger">Rediger tekst</button>
                    </div>
                </div>
            }
            else if (_mode == CoachMode.Forbedringer && _forbedringer is not null)
            {
                @if (_forbedringer.Count == 0)
                {
                    <div class="sidepanel-success">
                        <div class="check-icon" aria-hidden="true">✓</div>
                        <h3>Ingen forbedringer foreslået</h3>
                        <p>Modellen vurderer at teksten allerede er velformuleret.</p>
                        <button class="btn-secondary" @onclick="Rediger">Rediger tekst</button>
                    </div>
                }
                else
                {
                    <h3>@_forbedringer.Count forslag</h3>
                    <ul class="forbedring-list">
                        @for (var i = 0; i < _forbedringer.Count; i++)
                        {
                            var idx = i;
                            var f = _forbedringer[idx];
                            <li class="forbedring">
                                <div class="forbedring-head">
                                    <span class="badge">Afsnit @(f.ParagraphIndex + 1)</span>
                                </div>
                                <div class="forbedring-block original">
                                    <div class="forbedring-label">Original</div>
                                    <div class="forbedring-text">@f.Original</div>
                                </div>
                                <div class="forbedring-block suggested">
                                    <div class="forbedring-label">Forslag</div>
                                    <div class="forbedring-text">@f.Suggested</div>
                                </div>
                                <p class="correction-explanation">@f.Explanation</p>
                                <div class="correction-actions">
                                    <button class="btn-small btn-primary" @onclick="() => AnvendForbedring(idx)">Anvend</button>
                                    <button class="btn-small btn-link" @onclick="() => IgnorerForbedring(idx)">Ignorer</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        </aside>
    </div>

    @if (_latencyMs is not null)
    {
        <footer class="skrivekompasset-footer">
            @FooterVerb på @(_latencyMs)ms
            @if (_usage is not null)
            {
                <span> · @_usage.TotalTokens tokens (@_usage.InputTokens ind / @_usage.OutputTokens ud)</span>
            }
        </footer>
    }
</div>

@code {
    public enum CoachMode { Stavning, Forbedringer, Laerer, Hjaelp }

    private CoachMode _mode = CoachMode.Stavning;
    private Klassetrin _klassetrin = Klassetrin.Mellemtrin;

    // S/F/L deler input (de arbejder alle på samme tekst). Hjælp har sin egen — det er en opgavebeskrivelse, ikke skribentens tekst.
    private string _tekst = string.Empty;
    private string _hjaelpTekst = string.Empty;

    private List<Correction>? _corrections;
    private List<Forbedring>? _forbedringer;
    private LaererFeedback? _laererFeedback;
    private OpgaveHjaelp? _opgaveHjaelp;
    private string[] _afsnit = Array.Empty<string>();

    // Per-mode metadata. Hjælp's persisterer på tværs af mode-skift; de andre nulstilles når man skifter væk.
    private long? _stavningLatencyMs;
    private ResponsesUsage? _stavningUsage;
    private long? _forbedringerLatencyMs;
    private ResponsesUsage? _forbedringerUsage;
    private long? _laererLatencyMs;
    private ResponsesUsage? _laererUsage;
    private long? _hjaelpLatencyMs;
    private ResponsesUsage? _hjaelpUsage;

    private bool _isChecking;
    private string? _fejlbesked;
    private CancellationTokenSource? _cts;

    private System.Timers.Timer? _elapsedTimer;
    private System.Diagnostics.Stopwatch? _elapsedWatch;
    private double _elapsedSeconds;

    private string CurrentInput
    {
        get => _mode == CoachMode.Hjaelp ? _hjaelpTekst : _tekst;
        set
        {
            if (_mode == CoachMode.Hjaelp) _hjaelpTekst = value;
            else _tekst = value;
        }
    }

    private string CounterCssClass
    {
        get
        {
            var max = Skrivekompasset.MaxInputCharacters;
            var len = CurrentInput.Length;
            if (len > max) return "char-counter-over";
            if (len > max * 0.9) return "char-counter-near";
            return string.Empty;
        }
    }

    private long? _latencyMs => _mode switch
    {
        CoachMode.Stavning => _stavningLatencyMs,
        CoachMode.Forbedringer => _forbedringerLatencyMs,
        CoachMode.Laerer => _laererLatencyMs,
        CoachMode.Hjaelp => _hjaelpLatencyMs,
        _ => null
    };

    private ResponsesUsage? _usage => _mode switch
    {
        CoachMode.Stavning => _stavningUsage,
        CoachMode.Forbedringer => _forbedringerUsage,
        CoachMode.Laerer => _laererUsage,
        CoachMode.Hjaelp => _hjaelpUsage,
        _ => null
    };

    private bool HarResultat => _mode switch
    {
        CoachMode.Stavning => _corrections is not null,
        CoachMode.Forbedringer => _forbedringer is not null,
        CoachMode.Laerer => _laererFeedback is not null,
        CoachMode.Hjaelp => _opgaveHjaelp is not null,
        _ => false
    };

    private string LeadText => _mode switch
    {
        CoachMode.Stavning => "Indsæt en tekst og lad ordbogen.ai finde stave-, grammatik- og stilfejl.",
        CoachMode.Forbedringer => "Indsæt en tekst og få forslag til hvordan hvert afsnit kan blive skarpere.",
        CoachMode.Laerer => "Indsæt en tekst og få pædagogisk tilbagemelding tilpasset klassetrinnet.",
        CoachMode.Hjaelp => "Indsæt en opgave og få en guide til at komme i gang — uden at få svaret.",
        _ => string.Empty
    };

    private string PlaceholderText => _mode switch
    {
        CoachMode.Stavning => "Indsæt eller skriv din danske tekst her...",
        CoachMode.Forbedringer => "Indsæt en tekst med flere afsnit (adskilt af blanke linjer)...",
        CoachMode.Laerer => "Indsæt elevens tekst her...",
        CoachMode.Hjaelp => "Paste opgavebeskrivelsen her — ikke dit svar...",
        _ => string.Empty
    };

    private string SidepanelEmptyText => _mode switch
    {
        CoachMode.Stavning => "Tryk Tjek tekst for at få feedback på stave-, grammatik- og stilfejl.",
        CoachMode.Forbedringer => "Tryk Foreslå forbedringer for at få omformuleringer pr. afsnit.",
        CoachMode.Laerer => "Vælg klassetrin og tryk Hent feedback for at få en lærerlignende tilbagemelding.",
        CoachMode.Hjaelp => "Vælg klassetrin og tryk Hjælp mig i gang for at få en guide.",
        _ => string.Empty
    };

    private string CheckButtonLabel => _mode switch
    {
        CoachMode.Stavning => "Tjek tekst",
        CoachMode.Forbedringer => "Foreslå forbedringer",
        CoachMode.Laerer => "Hent feedback",
        CoachMode.Hjaelp => "Hjælp mig i gang",
        _ => "Tjek"
    };

    private string CheckingLabel => _mode switch
    {
        CoachMode.Stavning => "Tjekker...",
        CoachMode.Forbedringer => "Analyserer...",
        CoachMode.Laerer => "Bedømmer...",
        CoachMode.Hjaelp => "Tænker...",
        _ => "Arbejder..."
    };

    private string FooterVerb => _mode switch
    {
        CoachMode.Stavning => "Tjekket",
        CoachMode.Forbedringer => "Analyseret",
        CoachMode.Laerer => "Bedømt",
        CoachMode.Hjaelp => "Klar",
        _ => "Færdig"
    };

    private const string EksempelStavning =
        "Han gik på en lang gå-tur og spilst en is sammen med hans bror. " +
        "De snakkede meget om hvor lækre isene smag, og hvordan de gik forbi en gammel mand der såd på en bænk.";

    private const string EksempelForbedringer =
        "Vi har i lang tid haft et stort fokus på at forbedre kvaliteten af vores produkter. " +
        "Det er noget vi tager meget alvorligt og som vi prioriterer højt.\n\n" +
        "I løbet af det sidste år, har vi lavet en masse ændringer på den måde som vi arbejder på, og det har givet rigtig gode resultater i forhold til hvor tilfredse vores kunder er.\n\n" +
        "Fremover vil vi fortsætte med at have fokus på dette område, fordi vi mener at det er vigtigt for vores forretning og for vores kunder.";

    private const string EksempelLaerer =
        "Min sommerferie var rigtig god. Jeg var i sommerhus med min familie. " +
        "Vi var ved stranden hver dag. Vi spiste is. Det var sjovt. " +
        "Min lillebror byggede et stort sandslot. Det væltede da en bølge kom. " +
        "Min mor og far læste bøger. Jeg legede med min ven Mads.";

    private const string EksempelHjaelp =
        "Skriv en kort tekst på 250-400 ord om en oplevelse fra din sommerferie. " +
        "Teksten skal indeholde mindst tre forskellige sansebeskrivelser (fx hvad du så, " +
        "hørte eller smagte) og bruge mindst to forskellige tider (datid og førnutid). " +
        "Husk afsnit og en klar afslutning.";

    private void SetMode(CoachMode mode)
    {
        if (_mode == mode || _isChecking) return;

        // S/F/L har "fresh start" pr. mode-skift — eksisterende adfærd, og rimeligt
        // fordi de tre deler input og deres resultater bliver stale ved tekst-ændringer.
        // Hjælp er undtagelsen: dens input og resultat bevares så man kan vende tilbage.
        if (_mode != CoachMode.Hjaelp)
        {
            ClearSharedModesState();
        }

        _mode = mode;
        _fejlbesked = null;
    }

    private void ClearSharedModesState()
    {
        _corrections = null;
        _forbedringer = null;
        _laererFeedback = null;
        _afsnit = Array.Empty<string>();
        _stavningLatencyMs = null;
        _stavningUsage = null;
        _forbedringerLatencyMs = null;
        _forbedringerUsage = null;
        _laererLatencyMs = null;
        _laererUsage = null;
    }

    private async Task TjekAsync()
    {
        _fejlbesked = null;
        _isChecking = true;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        StartElapsedTimer();

        try
        {
            if (_mode == CoachMode.Stavning)
            {
                var resultat = await Skrivekompasset.TjekTekstAsync(_tekst, _cts.Token);
                _corrections = resultat.Corrections.ToList();
                _stavningLatencyMs = resultat.LatencyMs;
                _stavningUsage = resultat.Usage;
            }
            else if (_mode == CoachMode.Forbedringer)
            {
                var resultat = await Skrivekompasset.ForbedrTekstAsync(_tekst, _cts.Token);
                _forbedringer = resultat.Forbedringer.ToList();
                _afsnit = resultat.Afsnit.ToArray();
                _forbedringerLatencyMs = resultat.LatencyMs;
                _forbedringerUsage = resultat.Usage;
            }
            else if (_mode == CoachMode.Laerer)
            {
                var resultat = await Skrivekompasset.LaererFeedbackAsync(_tekst, _klassetrin, _cts.Token);
                _laererFeedback = resultat.Feedback;
                _laererLatencyMs = resultat.LatencyMs;
                _laererUsage = resultat.Usage;
            }
            else if (_mode == CoachMode.Hjaelp)
            {
                var resultat = await Skrivekompasset.HjaelpIGangAsync(_hjaelpTekst, _klassetrin, _cts.Token);
                _opgaveHjaelp = resultat.Hjaelp;
                _hjaelpLatencyMs = resultat.LatencyMs;
                _hjaelpUsage = resultat.Usage;
            }
        }
        catch (OperationCanceledException)
        {
            // bruger navigerede væk eller startede ny check — ignorér
        }
        catch (OrdbogenApiException ex)
        {
            _fejlbesked = ex.Message;
            Log.LogWarning(ex, "Skrivekompasset-kald fejlede");
        }
        catch (Exception ex)
        {
            _fejlbesked = "Uventet fejl: " + ex.Message;
            Log.LogError(ex, "Uventet fejl ved skrivekompasset-kald");
        }
        finally
        {
            StopElapsedTimer();
            _isChecking = false;
        }
    }

    private void StartElapsedTimer()
    {
        _elapsedSeconds = 0;
        _elapsedWatch = System.Diagnostics.Stopwatch.StartNew();

        if (_elapsedTimer is null)
        {
            _elapsedTimer = new System.Timers.Timer(200) { AutoReset = true };
            _elapsedTimer.Elapsed += (_, _) =>
            {
                _elapsedSeconds = _elapsedWatch?.Elapsed.TotalSeconds ?? 0;
                _ = InvokeAsync(StateHasChanged);
            };
        }
        _elapsedTimer.Start();
    }

    private void StopElapsedTimer()
    {
        _elapsedTimer?.Stop();
        _elapsedWatch?.Stop();
    }

    // --- Stavning / grammatik ---

    private void AnvendCorrection(int index)
    {
        if (_corrections is null || index < 0 || index >= _corrections.Count) return;
        var c = _corrections[index];

        var (start, end) = LokaliserOriginal(c);
        if (start < 0)
        {
            _fejlbesked = $"Kunne ikke finde \"{c.Original}\" i teksten — rettelsen blev ikke anvendt.";
            return;
        }

        _tekst = _tekst[..start] + c.Suggested + _tekst[end..];
        // Fjern den anvendte rettelse og realign de resterende. Deres Original-strenge
        // er stadig gyldige; kun deres Start/End-offsets er forskudt af tekst-ændringen.
        _corrections.RemoveAt(index);
        RealignResterendeCorrections();
        _fejlbesked = null;
    }

    private void RealignResterendeCorrections()
    {
        if (_corrections is null || _corrections.Count == 0) return;
        var opdateret = new List<Correction>(_corrections.Count);
        foreach (var c in _corrections)
        {
            var (s, e) = LokaliserOriginal(c);
            if (s >= 0)
            {
                opdateret.Add(c with { Start = s, End = e });
            }
            // else: original ikke længere i teksten (fx et ord der allerede er blevet rettet) — drop
        }
        _corrections = opdateret;
    }

    private void AnvendAlleCorrections()
    {
        if (_corrections is null || _corrections.Count == 0) return;

        var lokaliseret = _corrections
            .Select(c => (c, span: LokaliserOriginal(c)))
            .Where(t => t.span.start >= 0)
            .OrderByDescending(t => t.span.start)
            .ToList();

        var droppet = _corrections.Count - lokaliseret.Count;

        var sb = new System.Text.StringBuilder(_tekst);
        foreach (var (c, (start, end)) in lokaliseret)
        {
            if (end > sb.Length) continue;
            sb.Remove(start, end - start);
            sb.Insert(start, c.Suggested);
        }
        _tekst = sb.ToString();
        _corrections = null;
        _stavningLatencyMs = null;
        _stavningUsage = null;
        _fejlbesked = droppet > 0
            ? $"{droppet} rettelse{(droppet == 1 ? "" : "r")} kunne ikke lokaliseres og blev sprunget over."
            : null;
    }

    private void IgnorerCorrection(int index)
    {
        if (_corrections is null || index < 0 || index >= _corrections.Count) return;
        _corrections.RemoveAt(index);
    }

    private (int start, int end) LokaliserOriginal(Correction c)
    {
        if (string.IsNullOrEmpty(c.Original)) return (-1, -1);

        if (c.Start >= 0 && c.End <= _tekst.Length && c.Start < c.End
            && _tekst.AsSpan(c.Start, c.End - c.Start).SequenceEqual(c.Original))
        {
            return (c.Start, c.End);
        }

        var first = _tekst.IndexOf(c.Original, StringComparison.Ordinal);
        if (first < 0) return (-1, -1);

        var bestPos = first;
        var bestDist = Math.Abs(first - c.Start);
        var pos = first;
        while ((pos = _tekst.IndexOf(c.Original, pos + 1, StringComparison.Ordinal)) >= 0)
        {
            var dist = Math.Abs(pos - c.Start);
            if (dist < bestDist) { bestDist = dist; bestPos = pos; }
        }
        return (bestPos, bestPos + c.Original.Length);
    }

    // --- Forbedringer ---

    private void AnvendForbedring(int index)
    {
        if (_forbedringer is null || index < 0 || index >= _forbedringer.Count) return;
        var f = _forbedringer[index];
        if (f.ParagraphIndex < 0 || f.ParagraphIndex >= _afsnit.Length) return;

        _afsnit[f.ParagraphIndex] = f.Suggested;
        _tekst = string.Join("\n\n", _afsnit);
        _forbedringer.RemoveAt(index);
        _fejlbesked = null;
    }

    private void AnvendAlleForbedringer()
    {
        if (_forbedringer is null || _forbedringer.Count == 0) return;

        foreach (var f in _forbedringer)
        {
            if (f.ParagraphIndex >= 0 && f.ParagraphIndex < _afsnit.Length)
            {
                _afsnit[f.ParagraphIndex] = f.Suggested;
            }
        }
        _tekst = string.Join("\n\n", _afsnit);
        _forbedringer = null;
        _forbedringerLatencyMs = null;
        _forbedringerUsage = null;
        _fejlbesked = null;
    }

    private void IgnorerForbedring(int index)
    {
        if (_forbedringer is null || index < 0 || index >= _forbedringer.Count) return;
        _forbedringer.RemoveAt(index);
    }

    // --- Fælles ---

    private void Rediger()
    {
        // Ryd kun det aktuelle modes resultat så brugeren kan tilbage til input-feltet
        // og evt. køre tjekket igen — andre modes' state forbliver urørt.
        switch (_mode)
        {
            case CoachMode.Stavning:
                _corrections = null;
                _stavningLatencyMs = null;
                _stavningUsage = null;
                break;
            case CoachMode.Forbedringer:
                _forbedringer = null;
                _afsnit = Array.Empty<string>();
                _forbedringerLatencyMs = null;
                _forbedringerUsage = null;
                break;
            case CoachMode.Laerer:
                _laererFeedback = null;
                _laererLatencyMs = null;
                _laererUsage = null;
                break;
            case CoachMode.Hjaelp:
                _opgaveHjaelp = null;
                _hjaelpLatencyMs = null;
                _hjaelpUsage = null;
                break;
        }
    }

    private void Ryd()
    {
        if (_mode == CoachMode.Hjaelp)
        {
            _hjaelpTekst = string.Empty;
            _opgaveHjaelp = null;
            _hjaelpLatencyMs = null;
            _hjaelpUsage = null;
        }
        else
        {
            // S/F/L deler input — at rydde teksten gør alle deres resultater stale
            _tekst = string.Empty;
            ClearSharedModesState();
        }
        _fejlbesked = null;
    }

    private void IndsætEksempel()
    {
        var eksempel = _mode switch
        {
            CoachMode.Stavning => EksempelStavning,
            CoachMode.Forbedringer => EksempelForbedringer,
            CoachMode.Laerer => EksempelLaerer,
            CoachMode.Hjaelp => EksempelHjaelp,
            _ => EksempelStavning
        };
        if (_mode == CoachMode.Hjaelp) _hjaelpTekst = eksempel;
        else _tekst = eksempel;
    }

    private static string KlassetrinLabel(Klassetrin trin) => trin switch
    {
        Klassetrin.Indskoling => "Indskoling (0.-3. klasse)",
        Klassetrin.Mellemtrin => "Mellemtrin (4.-6. klasse)",
        Klassetrin.Udskoling => "Udskoling (7.-9. klasse)",
        Klassetrin.Gymnasium => "Gymnasium",
        Klassetrin.Voksen => "Voksen",
        _ => trin.ToString()
    };

    private static string CssClassFor(Correction c) => c.ParsedType switch
    {
        CorrectionType.Stavning => "type-stavning",
        CorrectionType.Grammatik => "type-grammatik",
        CorrectionType.Stil => "type-stil",
        _ => "type-stil"
    };

    private static string LabelFor(Correction c) => c.ParsedType switch
    {
        CorrectionType.Stavning => "Stavning",
        CorrectionType.Grammatik => "Grammatik",
        CorrectionType.Stil => "Stil",
        _ => c.Type
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _elapsedTimer?.Dispose();
    }
}
